# Endereço público da aplicação, sem barra no final
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# Aplicativo OAuth do HighLevel
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://seu-dominio.com.br/api/integrations/highlevel/callback

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GHL_TOKEN_ENCRYPTION_KEY=

# Postgres persistente (Neon, Vercel Postgres ou equivalente)
DATABASE_URL=

# Preencha depois de instalar o aplicativo na subconta
GHL_LOCATION_ID=

# O funil e a etapa serão localizados automaticamente por estes nomes.
GHL_PIPELINE_NAME=Funil de Leads (simulador)
GHL_PIPELINE_STAGE_NAME=Novo Lead

# IDs opcionais para substituir a localização automática por nome.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Opcional: associe nomes internos aos IDs dos campos personalizados do contato.
# Exemplo em uma única linha:
# Os quatro campos atuais já possuem suas chaves configuradas no projeto.
# Use este JSON apenas para substituir uma chave ou acrescentar novos campos.
# GHL_CUSTOM_FIELD_MAP={"householdIncome":"ID_OU_CHAVE","creditType":"ID_OU_CHAVE"}
GHL_CUSTOM_FIELD_MAP=

# Integração genérica alternativa
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
